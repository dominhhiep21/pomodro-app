CREATE TABLE IF NOT EXISTS learning_journal (
    id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    work_round INTEGER NOT NULL,
    achievements TEXT NOT NULL,
    focus_rating INTEGER NOT NULL,
    created_at_millis INTEGER NOT NULL,
    sync_status TEXT NOT NULL DEFAULT 'LOCAL_ONLY',

    FOREIGN KEY(session_id) REFERENCES session_history_local(id)
);

CREATE INDEX IF NOT EXISTS learning_journal_session_idx ON learning_journal(session_id);

insertJournalEntry:
INSERT INTO learning_journal (
    id,
    session_id,
    work_round,
    achievements,
    focus_rating,
    created_at_millis,
    sync_status
)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectJournalsBySessionId:
SELECT *
FROM learning_journal
WHERE session_id = ?
ORDER BY work_round ASC;

deleteJournalsBySessionId:
DELETE FROM learning_journal
WHERE session_id = ?;

deleteAllJournals:
DELETE FROM learning_journal;
