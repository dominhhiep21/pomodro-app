CREATE TABLE IF NOT EXISTS session_history_local (
    id TEXT NOT NULL PRIMARY KEY,
    user_id TEXT,
    anonymous_user_id TEXT,
    session_mode TEXT,
    status TEXT NOT NULL,
    current_learning_mode TEXT NOT NULL,
    started_at TEXT NOT NULL,
    started_at_millis INTEGER,
    ended_at TEXT,
    ended_at_millis INTEGER,
    last_paused_at TEXT,
    last_paused_at_millis INTEGER,
    planned_work_minutes INTEGER,
    planned_break_minutes INTEGER,
    planned_long_break_minutes INTEGER,
    completed_work_rounds INTEGER,
    completed_break_rounds INTEGER,
    last_background_id TEXT,
    last_music_id TEXT,
    last_ambient_sound_json TEXT,
    total_focus_seconds INTEGER,
    total_break_seconds INTEGER,
    total_paused_seconds INTEGER,
    created_at TEXT NOT NULL,
    created_at_millis INTEGER,
    updated_at TEXT NOT NULL,
    updated_at_millis INTEGER,
    sync_status TEXT
);

CREATE INDEX IF NOT EXISTS session_history_local_user_started_at_idx
ON session_history_local(user_id, started_at DESC);

CREATE INDEX IF NOT EXISTS session_history_local_anonymous_user_started_at_idx
ON session_history_local(anonymous_user_id, started_at DESC);

CREATE INDEX IF NOT EXISTS session_history_local_sync_status_idx
ON session_history_local(sync_status);

CREATE INDEX IF NOT EXISTS session_history_local_status_idx
ON session_history_local(status);

CREATE INDEX IF NOT EXISTS session_history_local_updated_at_idx
ON session_history_local(updated_at DESC);

insertSessionHistory:
INSERT INTO session_history_local (
    id,
    user_id,
    anonymous_user_id,
    session_mode,
    current_learning_mode,
    status,
    started_at,
    started_at_millis,
    ended_at,
    ended_at_millis,
    last_paused_at,
    last_paused_at_millis,
    planned_work_minutes,
    planned_break_minutes,
    planned_long_break_minutes,
    completed_work_rounds,
    completed_break_rounds,
    last_background_id,
    last_music_id,
    last_ambient_sound_json,
    total_focus_seconds,
    total_break_seconds,
    total_paused_seconds,
    created_at,
    created_at_millis,
    updated_at,
    updated_at_millis,
    sync_status
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateSessionHistory:
UPDATE session_history_local
SET
    user_id = ?,
    anonymous_user_id = ?,
    session_mode = ?,
    current_learning_mode = ?,
    status = ?,
    started_at = ?,
    started_at_millis = ?,
    ended_at = ?,
    ended_at_millis = ?,
    last_paused_at = ?,
    last_paused_at_millis = ?,
    planned_work_minutes = ?,
    planned_break_minutes = ?,
    planned_long_break_minutes = ?,
    completed_work_rounds = ?,
    completed_break_rounds = ?,
    last_background_id = ?,
    last_music_id = ?,
    last_ambient_sound_json = ?,
    total_focus_seconds = ?,
    total_break_seconds = ?,
    total_paused_seconds = ?,
    created_at = ?,
    created_at_millis = ?,
    updated_at = ?,
    updated_at_millis = ?,
    sync_status = ?
WHERE id = ?;

selectSessionHistoryById:
SELECT *
FROM session_history_local
WHERE id = ?;

selectAllSessionHistory:
SELECT *
FROM session_history_local
WHERE status <> 'DELETED'
ORDER BY started_at DESC;

selectTotalFocusSeconds:
SELECT COALESCE(SUM(total_focus_seconds), 0)
FROM session_history_local
WHERE status = 'COMPLETED';

deleteAllSessionHistory:
DELETE FROM session_history_local;

deleteSessionHistoryById:
UPDATE session_history_local
SET status = 'DELETED'
WHERE id = ?;

getFocusSecondsBetween:
SELECT COALESCE(SUM(total_focus_seconds), 0)
FROM session_history_local
WHERE started_at_millis IS NOT NULL
AND started_at_millis >= ?
AND started_at_millis < ?;

getCompletedWorkRoundsBetween:
SELECT COALESCE(SUM(completed_work_rounds), 0)
FROM session_history_local
WHERE started_at_millis IS NOT NULL
AND started_at_millis >= ?
AND started_at_millis < ?;

getFocusDays:
SELECT
    date(started_at_millis / 1000, 'unixepoch', 'localtime') AS day_key
FROM session_history_local
WHERE started_at_millis IS NOT NULL
GROUP BY date(started_at_millis / 1000, 'unixepoch', 'localtime')
HAVING COALESCE(SUM(total_focus_seconds), 0) > 0
ORDER BY day_key DESC;

getDailyStatsBetween:
SELECT
    date(started_at_millis / 1000, 'unixepoch', 'localtime') AS day_key,
    COALESCE(SUM(total_focus_seconds), 0) AS focus_seconds,
    COALESCE(SUM(completed_work_rounds), 0) AS completed_pomodoros
FROM session_history_local
WHERE started_at_millis IS NOT NULL
AND started_at_millis >= ?
AND started_at_millis < ?
GROUP BY date(started_at_millis / 1000, 'unixepoch', 'localtime')
ORDER BY day_key DESC;

getHomeDashboardStats:
WITH params AS (
    SELECT
        CAST(? AS INTEGER) AS yesterday_start_millis,
        CAST(? AS INTEGER) AS today_start_millis,
        CAST(? AS INTEGER) AS tomorrow_start_millis
),
filtered_sessions AS (
    SELECT
        started_at_millis,
        COALESCE(total_focus_seconds, 0) AS total_focus_seconds,
        COALESCE(completed_work_rounds, 0) AS completed_work_rounds
    FROM session_history_local
    WHERE started_at_millis IS NOT NULL
),
daily_stats AS (
    SELECT
        date(started_at_millis / 1000, 'unixepoch', 'localtime') AS day_key,
        SUM(total_focus_seconds) AS focus_seconds,
        SUM(completed_work_rounds) AS completed_pomodoros
    FROM filtered_sessions
    GROUP BY day_key
),
today_stats AS (
    SELECT
        COALESCE(SUM(fs.total_focus_seconds), 0) AS focus_seconds,
        COALESCE(SUM(fs.completed_work_rounds), 0) AS completed_pomodoros
    FROM filtered_sessions fs, params p
    WHERE
        fs.started_at_millis >= p.today_start_millis
        AND fs.started_at_millis < p.tomorrow_start_millis
),
yesterday_stats AS (
    SELECT
        COALESCE(SUM(fs.total_focus_seconds), 0) AS focus_seconds,
        COALESCE(SUM(fs.completed_work_rounds), 0) AS completed_pomodoros
    FROM filtered_sessions fs, params p
    WHERE
        fs.started_at_millis >= p.yesterday_start_millis
        AND fs.started_at_millis < p.today_start_millis
),
date_keys AS (
    SELECT
        date(p.today_start_millis / 1000, 'unixepoch', 'localtime') AS today_key
    FROM params p
),
focus_days AS (
    SELECT day_key
    FROM daily_stats
    WHERE focus_seconds > 0
),
current_streak_ranked AS (
    SELECT
        fd.day_key,
        (
            SELECT COUNT(*)
            FROM focus_days fd2
            WHERE fd2.day_key >= fd.day_key
        ) AS rn,
        CAST(
            julianday(dk.today_key) - julianday(fd.day_key)
            AS INTEGER
        ) AS diff_from_today
    FROM focus_days fd, date_keys dk
    WHERE fd.day_key <= dk.today_key
),
current_streak AS (
    SELECT COUNT(*) AS streak_days
    FROM current_streak_ranked
    WHERE diff_from_today = rn - 1
),
best_streak_grouped AS (
    SELECT
        fd.day_key,
        date(
            fd.day_key,
            '-' || (
                SELECT COUNT(*)
                FROM focus_days fd2
                WHERE fd2.day_key <= fd.day_key
            ) || ' days'
        ) AS streak_group
    FROM focus_days fd
),
best_streak_lengths AS (
    SELECT COUNT(*) AS streak_length
    FROM best_streak_grouped
    GROUP BY streak_group
),
best_streak AS (
    SELECT COALESCE(MAX(streak_length), 0) AS best_streak_days
    FROM best_streak_lengths
)
SELECT
    today_stats.focus_seconds AS today_focus_seconds,
    yesterday_stats.focus_seconds AS yesterday_focus_seconds,
    today_stats.focus_seconds - yesterday_stats.focus_seconds AS focus_seconds_diff,

    today_stats.completed_pomodoros AS today_completed_pomodoros,
    yesterday_stats.completed_pomodoros AS yesterday_completed_pomodoros,
    today_stats.completed_pomodoros - yesterday_stats.completed_pomodoros AS completed_pomodoros_diff,

    COALESCE(current_streak.streak_days, 0) AS current_streak_days,
    COALESCE(best_streak.best_streak_days, 0) AS best_streak_days
FROM today_stats, yesterday_stats, current_streak, best_streak;

CREATE TABLE IF NOT EXISTS learning_session_event_local (
    event_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,
    event_type TEXT NOT NULL,
    occurred_at_millis TEXT NOT NULL,
    background_id TEXT,
    music_id TEXT,
    ambient_sound_ids_json TEXT,
    remaining_seconds INTEGER,
    current_round INTEGER,
    metadata_json TEXT NOT NULL,
    sync_status TEXT NOT NULL,

    FOREIGN KEY(session_id) REFERENCES session_history_local(id)
);

CREATE INDEX IF NOT EXISTS learning_session_event_session_time_idx
ON learning_session_event_local(session_id, occurred_at_millis ASC);

CREATE INDEX IF NOT EXISTS learning_session_event_sync_status_idx
ON learning_session_event_local(sync_status);

CREATE INDEX IF NOT EXISTS learning_session_event_type_idx
ON learning_session_event_local(event_type);

insertLearningSessionEvent:
INSERT INTO learning_session_event_local (
    event_id,
    session_id,
    event_type,
    occurred_at_millis,
    background_id,
    music_id,
    ambient_sound_ids_json,
    remaining_seconds,
    current_round,
    metadata_json,
    sync_status
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

CREATE TABLE IF NOT EXISTS session_task (

    task_id TEXT NOT NULL PRIMARY KEY,
    session_id TEXT NOT NULL,

    title TEXT NOT NULL,
    is_completed INTEGER NOT NULL DEFAULT 0,

    focus_seconds INTEGER NOT NULL DEFAULT 0,

    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    completed_at TEXT,

    sync_status TEXT NOT NULL DEFAULT 'LOCAL_ONLY'
);

insertSessionTask:
INSERT INTO session_task(
    task_id,
    session_id,
    title,
    is_completed,
    focus_seconds,
    created_at,
    updated_at,
    completed_at,
    sync_status
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectTasksBySessionId:
SELECT *
FROM session_task
WHERE session_id = ?
ORDER BY created_at ASC;

updateTask:
UPDATE session_task
SET session_id = ?,
    title = ?,
    is_completed = ?,
    focus_seconds = ?,
    updated_at = ?,
    completed_at = ?,
    sync_status = ?
WHERE task_id = ?;

addTaskFocusSeconds:
UPDATE session_task
SET focus_seconds = focus_seconds + ?,
    updated_at = ?
WHERE task_id = ?;

deleteTask:
DELETE FROM session_task
WHERE task_id = ? AND session_id = ?;

deleteTasksBySessionId:
DELETE FROM session_task
WHERE session_id = ?;

selectTaskStatsBySessionId:
SELECT
    COUNT(*) AS total_tasks,
    SUM(CASE WHEN is_completed = 1 THEN 1 ELSE 0 END) AS completed_tasks,
    SUM(focus_seconds) AS total_task_focus_seconds
FROM session_task
WHERE session_id = ?;

deleteAllLearningSessionEvents:
DELETE FROM learning_session_event_local;